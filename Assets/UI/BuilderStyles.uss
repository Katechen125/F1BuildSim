/* ===================== ROOT ===================== */
#Root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(13, 10, 7);
}

/* ===================== LEFT PANEL ===================== */
#CategoryPanel {
    width: 160px;
    background-color: rgb(18, 13, 8);
    padding: 14px 0px 0px 0px;
    border-right-width: 1px;
    border-right-color: rgb(40, 28, 16);
    justify-content: flex-start;
    align-items: stretch;
    flex-shrink: 0;
}

#AppTitle {
    color: rgb(255, 107, 26);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 1px;
    -unity-text-align: upper-center;
    padding: 0 10px;
}

#AppSubtitle {
    color: rgb(80, 60, 38);
    font-size: 6px;
    letter-spacing: 1.5px;
    margin-bottom: 10px;
    -unity-text-align: upper-center;
    padding: 0 10px;
}

#SidebarDivider {
    height: 1px;
    background-color: rgb(40, 28, 16);
    margin-bottom: 8px;
}

#SidebarDivider2 {
    height: 1px;
    background-color: rgb(40, 28, 16);
    margin-bottom: 4px;
}

#ProgressSection {
    padding: 0 10px 8px 10px;
}

#ProgressHeader {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

#ProgressLabel {
    font-size: 6px;
    color: rgb(80, 60, 38);
    letter-spacing: 1px;
}

#ProgressCount {
    font-size: 7px;
    color: rgb(255, 107, 26);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

#ProgressTrack {
    height: 2px;
    background-color: rgb(32, 22, 10);
    border-radius: 1px;
}

#ProgressFill {
    height: 2px;
    background-color: rgb(255, 107, 26);
    border-radius: 1px;
    width: 0%;
}

#CategoryScroll {
    flex: 1;
}

/* Category buttons */
.cat-btn {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(0,0,0,0);
    padding: 0;
    margin-bottom: 1px;
    border-radius: 0;
}

.cat-btn:hover {
    background-color: rgb(25, 17, 9);
}

.cat-btn:hover .btn-lbl {
    color: rgb(200, 150, 80);
}

.cat-btn:hover .btn-tag {
    border-color: rgb(100, 65, 25);
    color: rgb(160, 100, 40);
}

.cat-btn--active {
    background-color: rgb(30, 20, 10);
    border-left-color: rgb(255, 107, 26);
}

.cat-btn--active .btn-tag {
    background-color: rgb(255, 107, 26);
    border-color: rgb(255, 107, 26);
    color: rgb(255, 255, 255);
}

.cat-btn--active .btn-lbl {
    color: rgb(255, 200, 130);
}

.cat-btn--done .btn-tag {
    border-color: rgb(120, 78, 25);
    color: rgb(190, 120, 45);
}

.cat-btn--done .btn-lbl {
    color: rgb(150, 110, 65);
}

.cat-btn--done .btn-status {
    color: rgb(255, 107, 26);
    -unity-font-style: bold;
}

.btn-inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 7px 8px 7px 8px;
    width: 100%;
}

.btn-left {
    flex-direction: row;
    align-items: center;
}

.btn-tag {
    background-color: rgb(30, 18, 8);
    border-width: 1px;
    border-color: rgb(55, 38, 18);
    border-radius: 2px;
    padding: 1px 4px;
    font-size: 6px;
    color: rgb(100, 70, 32);
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin-right: 6px;
}

.btn-lbl {
    font-size: 9px;
    color: rgb(130, 100, 65);
    letter-spacing: 0.3px;
}

.btn-status {
    font-size: 6px;
    color: rgb(55, 40, 22);
    letter-spacing: 1px;
}

/* ===================== MIDDLE PANEL ===================== */
#MiddlePanel {
    flex: 1;
    padding: 14px 14px 12px 14px;
    background-color: rgb(13, 10, 7);
    min-width: 300px;
}

/* Circuit banner */
#CircuitBanner {
    flex-direction: row;
    align-items: center;
    background-color: rgb(20, 14, 8);
    border-width: 1px;
    border-color: rgb(40, 28, 16);
    border-left-width: 2px;
    border-left-color: rgb(255, 107, 26);
    border-radius: 5px;
    padding: 6px 10px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

#CircuitBannerFlag {
    width: 24px;
    height: 16px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
    border-radius: 2px;
}

#CircuitBannerText {
    flex: 1;
}

#CircuitBannerLabel {
    font-size: 6px;
    color: rgb(70, 52, 30);
    letter-spacing: 1.5px;
    margin-bottom: 1px;
}

#CircuitBannerName {
    font-size: 10px;
    color: rgb(255, 107, 26);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

#CircuitBannerTags {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
}

.banner-tag {
    background-color: rgba(255, 107, 26, 0.12);
    border-width: 1px;
    border-color: rgba(255, 107, 26, 0.25);
    border-radius: 2px;
    padding: 1px 5px;
    font-size: 6px;
    color: rgb(200, 120, 50);
    letter-spacing: 1px;
    margin-right: 3px;
    margin-top: 2px;
}

/* Intro box */
#IntroBox {
    flex: 1;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 8px 0px;
}

#IntroTitle {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    margin-bottom: 4px;
    letter-spacing: 1.5px;
}

#IntroSubtitle {
    color: rgb(255, 107, 26);
    font-size: 7px;
    letter-spacing: 1.5px;
    -unity-text-align: upper-left;
    margin-bottom: 10px;
}

#IntroDesc {
    color: rgb(120, 92, 62);
    font-size: 9px;
    white-space: normal;
    -unity-text-align: upper-left;
}

#CategoryLabel {
    font-size: 14px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 2px;
    letter-spacing: 1.5px;
}

#CategoryCount {
    font-size: 7px;
    color: rgb(100, 75, 48);
    letter-spacing: 1.5px;
    margin-bottom: 10px;
}

#PartList {
    flex: 1;
}

/* ===================== PART CARDS ===================== */
.part-card {
    background-color: rgb(22, 16, 10);
    border-width: 1px;
    border-color: rgb(40, 30, 18);
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 6px;
    overflow: hidden;
    flex-shrink: 0;
}

.part-card:hover {
    border-color: rgb(85, 60, 30);
    background-color: rgb(26, 19, 11);
}

.part-card--selected {
    border-color: rgb(255, 107, 26);
    background-color: rgb(28, 18, 9);
    border-left-width: 2px;
    border-left-color: rgb(255, 107, 26);
}

.card-top-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
    overflow: hidden;
}

.part-icon {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    background-color: rgba(240, 220, 185, 0.08);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(240, 220, 185, 0.15);
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    padding: 4px;
}

.name-col {
    flex: 1;
    min-width: 0;
    flex-shrink: 1;
}

.part-name {
    font-size: 11px;
    color: rgb(240, 225, 205);
    -unity-font-style: bold;
    margin-bottom: 2px;
    white-space: normal;
}

.part-desc {
    font-size: 9px;
    color: rgb(130, 100, 68);
    white-space: normal;
}

.equipped-badge {
    color: rgb(255, 107, 26);
    font-size: 7px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    align-self: flex-start;
    margin-left: 6px;
    padding-top: 1px;
}

.card-divider {
    height: 1px;
    background-color: rgb(36, 26, 14);
    margin-bottom: 8px;
}

.stats-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.stat-chip {
    background-color: rgb(26, 18, 10);
    border-width: 1px;
    border-color: rgb(45, 32, 16);
    border-radius: 3px;
    padding: 3px 7px;
    margin-right: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.stat-chip-row {
    flex-direction: row;
    align-items: center;
}

.stat-chip-icon {
    font-size: 9px;
    color: rgb(255, 107, 26);
    margin-right: 3px;
    -unity-text-align: middle-center;
    width: 10px;
    height: 10px;
    flex-shrink: 0;
}

.stat-chip-label {
    font-size: 8px;
    color: rgb(170, 130, 75);
    letter-spacing: 0.5px;
}

.stat-chip--negative .stat-chip-icon {
    color: rgb(180, 90, 60);
}

.stat-chip--negative .stat-chip-label {
    color: rgb(180, 90, 60);
}

.select-btn {
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: rgb(60, 42, 20);
    border-radius: 3px;
    color: rgb(140, 105, 65);
    font-size: 8px;
    letter-spacing: 1px;
    padding: 5px 10px;
    -unity-font-style: bold;
    align-self: flex-start;
}

.select-btn:hover {
    background-color: rgb(255, 107, 26);
    border-color: rgb(255, 107, 26);
    color: rgb(255, 255, 255);
}

.select-btn--selected {
    background-color: rgb(40, 24, 8);
    border-color: rgb(255, 107, 26);
    color: rgb(255, 107, 26);
}

/* ===================== RIGHT PANEL ===================== */
#StatsPanel {
    width: 180px;
    background-color: rgb(11, 8, 5);
    padding: 14px 14px;
    border-left-width: 1px;
    border-left-color: rgb(40, 28, 16);
    flex-shrink: 0;
}

#BuildTitle {
    color: rgb(255, 107, 26);
    font-size: 7px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 2px;
}

#BuildSubtitle {
    color: rgb(70, 52, 32);
    font-size: 6px;
    letter-spacing: 1px;
    margin-bottom: 12px;
}

.stat-label {
    color: rgb(85, 65, 40);
    font-size: 7px;
    letter-spacing: 1.5px;
    margin-bottom: 1px;
}

.stat-value {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    letter-spacing: -1px;
}

.stat-value--small {
    font-size: 14px;
    margin-bottom: 7px;
    color: rgb(210, 185, 155);
}

#Divider {
    height: 1px;
    background-color: rgb(40, 28, 16);
    margin-bottom: 8px;
    margin-top: 1px;
}

#Divider2 {
    height: 1px;
    background-color: rgb(40, 28, 16);
    margin-bottom: 8px;
    margin-top: 1px;
}

#BuildStatus {
    color: rgb(130, 98, 60);
    font-size: 8px;
    white-space: normal;
    margin-bottom: 10px;
    letter-spacing: 0.5px;
}

.circuit-rating-value {
    font-size: 9px;
    color: rgb(255, 107, 26);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 10px;
    white-space: normal;
}

#BtnEvaluate {
    background-color: rgb(255, 107, 26);
    border-width: 0;
    border-radius: 3px;
    color: rgb(255, 255, 255);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    height: 30px;
    margin-bottom: 5px;
    margin-top: 6px;
    flex-shrink: 0;
}

#BtnEvaluate:hover {
    background-color: rgb(255, 130, 55);
}

#BtnReset {
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: rgb(45, 32, 16);
    border-radius: 3px;
    color: rgb(90, 68, 42);
    font-size: 7px;
    letter-spacing: 1.5px;
    height: 24px;
    flex-shrink: 0;
}

#BtnReset:hover {
    border-color: rgb(100, 75, 42);
    color: rgb(150, 112, 68);
}